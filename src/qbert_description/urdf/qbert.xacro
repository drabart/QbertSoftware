<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="qbert">
    <!-- Load the base model -->
    <xacro:include filename="$(find qbert_description)/urdf/qbert_base.xacro"/>

    <!-- Load the ros 2 control parameters -->
    <xacro:include filename="$(find qbert_description)/urdf/qbert_ros2control.xacro"/>

    <!-- Load additional gazebo info -->
    <xacro:include filename="$(find qbert_description)/urdf/qbert_gazebo.xacro"/>

    <!-- Load gazebo plugin -->
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>1</static_update_frequency>
        </plugin>
    </gazebo>

    <gazebo reference="camera_left">
        <sensor name="camera" type="camera">
            <pose> 0 0 0 -${pi/2} -${pi/2} 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>${pi/2}</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <topic>camera/image_raw</topic>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find qbert_control)/config/qbert_controllers.yaml</parameters>
            <controller_manager_prefix_node_name>controller_manager</controller_manager_prefix_node_name>
        </plugin>
    </gazebo>

</robot>
